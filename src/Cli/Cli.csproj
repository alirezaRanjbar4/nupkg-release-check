<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NupkgReleaseCheck</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nupkg-release-check</ToolCommandName>
    <PackageId>NupkgReleaseCheck.Tool</PackageId>
    <Version>0.1.0</Version>
    <Authors>alirezaRanjbar4</Authors>
    <Description>Offline checks for NuGet release identity, commit metadata and package-local Markdown links.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/alirezaRanjbar4/nupkg-release-check</RepositoryUrl>
    <PackageProjectUrl>https://github.com/alirezaRanjbar4/nupkg-release-check</PackageProjectUrl>
    <PackageTags>dotnet;csharp;nuget;nupkg;ci;documentation</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
    <None Include="../../README.md;../../LICENSE;../../CONTRIBUTING.md;../../ROADMAP.md;../../CHANGELOG.md;../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/*.md" Pack="true" PackagePath="docs/" />
    <None Include="../../examples/README.md" Pack="true" PackagePath="examples/" />
    <None Include="../../.github/workflows/ci.yml" Pack="true" PackagePath=".github/workflows/" />
  </ItemGroup>
</Project>
